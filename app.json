{
  "expo": {
    "name": "Pasaje Club",
    "slug": "pasaje-club-socios",
    "scheme": "pasajeclub",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#072D40",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.pasajeclub.app",
      "supportsTablet": true,
      "buildNumber": "12",
      "infoPlist": {
        "NSCameraUsageDescription": "Para sacar la foto de tu documentación y comprobantes de pago.",
        "NSPhotoLibraryUsageDescription": "Para elegir tu foto de perfil y adjuntar comprobantes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pasajeclub.app",
      "versionCode": 20,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icono-fg.png",
        "backgroundColor": "#072D40"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icono-fg.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#072D40"
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-updates",
      [
        "expo-camera",
        {
          "cameraPermission": "Para escanear y adjuntar documentación."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "279b20c9-8894-4fe4-abac-349b5daeff06"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/279b20c9-8894-4fe4-abac-349b5daeff06",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "icon": "./assets/icon.png"
  }
}
